{
	"name": "avls-site",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"setup": "npm install",
		"dev": "npm run dev --workspace web",
		"build": "npm run build --workspace web",
		"preview": "npm run preview --workspace web",
		"start": "npm run preview",
		"lint": "npm run lint --workspace web",
		"lint:warn": "npm run lint:warn --workspace web"
	},
	"devDependencies": {
		"knip": "^6.32.1"
	},
	"workspaces": [
		"apps/*"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
